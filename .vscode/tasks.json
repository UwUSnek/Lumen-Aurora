
{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "BUILD | Build compiler [Debug]",
            "command": "./Tools/Build_compiler.sh",
            "args": [ "Debug" ],
            "problemMatcher": [ "$gcc" ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "clear": true,
                "showReuseMessage": true,
            }
        },
        {
            "type": "shell",
            "label": "BUILD | Build compiler [Release]",
            "command": "./Tools/Build_compiler.sh",
            "args": [ "Release" ],
            "problemMatcher": [ "$gcc" ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "clear": true,
                "showReuseMessage": true,
            }
        },
        {
            "type": "shell",
            "label": "CLEAR | Clear compiler",
            "command": "./Tools/Clear_compiler.sh",
            "args": [],
            "problemMatcher": [ "$gcc" ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "clear": true,
                "showReuseMessage": true,
            }
        },
        {
            "type": "shell",
            "label": "TEST | Run manual testing",
            "command": "./Build/alc",
            "args": [
                "./Test/main.lum",
                "-I", "./Tests/BigSource",
                "-I", "./Tests/HugeSource",
                "-I", "./Tests/Includes",
                "-m", "./Test/out"
            ],
            "problemMatcher": [],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "type": "shell",
            "label": "TEST | Run help command (--help)",
            "command": "./Build/alc",
            "args": [
                "--help",
            ],
            "problemMatcher": [],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "type": "shell",
            "label": "TEST | Run version command (--version)",
            "command": "./Build/alc",
            "args": [
                "--version",
            ],
            "problemMatcher": [],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "type": "shell",
            "label": "BUILD | Build unit tests",
            "command": "./Tests/Build_tests.sh",
            "args": [],
            "problemMatcher": [],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "type": "shell",
            "label": "TEST | Run unit tests",
            "command": "./Tests/tests.out",
            "args": [],
            "problemMatcher": [],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "clear": true,
                "showReuseMessage": false
            }
        }
    ]
}