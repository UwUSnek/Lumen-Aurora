
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug compiler",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/Build/alc",
            "args": [
                "./Test/main.lmn",
                "-I", "./Tests/BigSource",
                "-I", "./Tests/HugeSource",
                "-I", "./Tests/Includes",
                "-m", "./Test/out",
                "--no-status"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "env": {},
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerPath": "/usr/bin/gdb",
            "logging": {
                "engineLogging": false
            }
        },
        {
            "name": "Debug unit tests",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/Tests/tests.out",
            "args": [
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "env": {},
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerPath": "/usr/bin/gdb",
            "logging": {
                "engineLogging": false
            }
        }
    ]
}